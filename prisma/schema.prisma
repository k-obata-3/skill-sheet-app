datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD
  TOOL
}

model Company {
  id           String        @id @default(cuid())
  name         String
  users        User[]
  sheets       SkillSheet[]
  skillMasters SkillMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String      @id @default(cuid())
  companyId    String
  email        String      @unique
  passwordHash String?
  name         String
  subName      String?
  role         Role
  dateOfBirth  String?
  isActive     Boolean     @default(true)
  skillSheet   SkillSheet?
  authTokens   AuthToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  sharedLinkUrls SharedLinkUrl[]

  @@unique([companyId, email])
}

model SkillSheet {
  id             String         @id @default(cuid())
  companyId      String
  userId         String         @unique
  skillSheetJson Json?
  summary        String?
  remarks        String?
  projects       SkillProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model SkillProject {
  id           String  @id @default(cuid())
  companyId    String
  skillSheetId String
  name         String
  periodFrom   String
  periodTo     String?
  projectJson  Json
  skillsJson   Json
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillSheet SkillSheet @relation(fields: [skillSheetId], references: [id], onDelete: Cascade)

  @@index([companyId, skillSheetId])
}

model SkillMaster {
  id        String        @id @default(cuid())
  companyId String
  category  SkillCategory
  name      String
  isActive  Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, category, name])
}

model AuthToken {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  tokenHash String    @unique
  type      String // "INVITE"
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([companyId, userId])
}

model SharedLinkUrl {
  id        String  @id @default(cuid())
  companyId String
  userId    String
  token     String  @unique
  type      String // "SKILLSHEET"
  expiresAt String?
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([companyId, userId])
}
